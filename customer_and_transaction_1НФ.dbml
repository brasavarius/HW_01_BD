Table transactions {
  transaction_id int [pk]
  product_id int
  customer_id int
  transaction_date date
  online_order bool
  order_status bool
  brand varchar
  product_line varchar
  product_class varchar
  product_size varchar
  list_price float
  standard_cost float
}

Table customers {
  customer_id int [pk]
  first_name varchar
  last_name varchar
  gender varchar
  DOB date
  job_title varchar
  job_industry_category varchar
  wealth_segment varchar
  deceased_indicator bool
  owns_car bool
  address varchar
  postcode int
  state varchar
  country varchar
  property_valuation int
}

Ref: transactions.customer_id > customers.customer_id